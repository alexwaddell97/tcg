{
  "name": "@tcg/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -b",
    "electron:dev": "concurrently --kill-others \"vite --port 5174 --strictPort\" \"wait-on http://localhost:5174 && cross-env ELECTRON_START_URL=http://localhost:5174 electron .\"",
    "electron:build": "pnpm electron:bundle && electron-builder",
    "electron:build:mac": "pnpm electron:bundle && electron-builder --mac",
    "electron:build:win": "pnpm electron:bundle && electron-builder --win",
    "electron:build:linux": "pnpm electron:bundle && electron-builder --linux",
    "mobile:build": "tsc -b && vite build --mode mobile",
    "mobile:sync": "pnpm mobile:build && cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:run:ios": "pnpm mobile:sync && cap run ios",
    "mobile:run:android": "pnpm mobile:sync && cap run android",
    "electron:bundle": "tsc -b && vite build --mode desktop",
    "electron:start": "pnpm electron:bundle && electron .",
    "electron:pack": "pnpm electron:bundle && electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tcg/shared": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.arenaeternal.game",
    "productName": "Arena Eternal",
    "directories": {
      "buildResources": "build",
      "output": "../../dist-electron"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*.cjs"
        ]
      },
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "npmRebuild": false
  },
  "description": "Arena Eternal fantasy card game"
}
